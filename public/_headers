# Static files can be served by the asset layer before the application Worker.
# Keep their browser behavior aligned with Worker-generated media responses.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.webp
  Content-Type: image/webp
  Content-Disposition: inline
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pinterest pin images of the free worksheets (public marketing art, fetched cross-origin when publishing).
/pinterest/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Free teacher templates (PDF and preview images): public downloads, linked from /material-ele/plantillas.
/plantillas/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
