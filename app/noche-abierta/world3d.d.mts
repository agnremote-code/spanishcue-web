export type Box = { x0: number; x1: number; z0: number; z1: number; vehicle?: string; npc?: string };
export type Bounds = { minX: number; maxX: number; minZ: number; maxZ: number };
export type Door = { side: 'north' | 'south'; at: number };
export type Building = { id: string; x0: number; x1: number; z0: number; z1: number; h: number; style: string; location?: string; sign?: string; door?: Door; rooftop?: boolean };
export type Vehicle = { id: string; kind: 'taxi' | 'broken' | 'sedan' | 'coupe'; x: number; z: number; heading: number; location?: string; color?: string; hoodOpen?: boolean };
export type TrafficCar = { id: string; lane: number; dir: 1 | -1; start: number; speed: number; kind: 'sedan' | 'coupe'; color: string };
export type MovingCar = { id: string; lane: number; dir: number; x: number; speed: number; cruise: number };
export type Look = { shirt: string; pants?: string; hair: string; skin: string; shoes?: string };
export type Npc = {
  id: string; x: number; z: number; facing: number; location?: string; activity?: string; look: Look; seated?: boolean; bike?: boolean;
  walk?: { axis: 'x' | 'z'; from: number; to: number; speed: number };
};
export type Target = {
  id: string; location: string; activity?: string; x: number; z: number; radius: number; key: 'E' | 'F'; verb: string; stage: string;
  npc?: string; vehicle?: string; shot?: Shot;
};
export type Hotspot = {
  id: string; location: string; activity: string; x: number; z: number; radius: number; key: 'E'; verb: string; at: { x: number; z: number };
};
export type RoomExit = { id: string; location: string; x: number; z: number; radius: number; key: 'E'; verb: string; exit: true };
export type Room = {
  location: string; origin: { x: number; z: number }; size: { w: number; d: number }; height: number;
  spawn: { x: number; z: number; heading: number }; exit: { x: number; z: number; radius: number };
  hotspots: { activity: string; x: number; z: number; at: { x: number; z: number }; verb: string; radius?: number }[];
  solids: Box[];
};
export type RoomLayout = {
  stage: string; location: string; height: number; bounds: Bounds; spawn: { x: number; z: number; heading: number };
  exit: RoomExit; hotspots: Hotspot[]; solids: Box[];
};
export type Stage = {
  origin: { x: number; z: number }; size?: { w: number; d: number }; roof?: number; walk?: boolean;
  spot: { x: number; z: number; heading: number };
  camera: { x: number; y: number; z: number }; look: { x: number; y: number; z: number };
};
export type Player = { x: number; z: number; heading: number; speed?: number };
export type Step = { x: number; z: number; heading: number; speed: number; moving: boolean };
export type Input = { x: number; y: number; sprint?: boolean; walk?: boolean; yaw?: number };
export type Preset = { id: string; distance: number; height: number; ahead: number };
export type Shot = { camera: { x: number; y: number; z: number }; look: { x: number; y: number; z: number } };

export const WORLD_BOUNDS: Bounds;
export const ROAD_HALF: number;
export const SIDEWALK: number;
export const PLAYER_RADIUS: number;
export const WALK_SPEED: number;
export const RUN_SPEED: number;
export const SPRINT_SPEED: number;
export const ACCELERATION: number;
export const DECELERATION: number;
export const TURN_RATE: number;
export const RUN_STRIDE: number;
export const WALK_STRIDE: number;
export const SPAWN: Player;
export const BUILDINGS: Building[];
export const PLAZA: { x0: number; x1: number; z0: number; z1: number; fountain: { x: number; z: number; r: number } };
export const PARK_LANE: number;
export const TRAFFIC_LANE: number;
export const VEHICLES: Vehicle[];
export const VEHICLE_SIZE: { length: number; width: number };
export const TRAFFIC: TrafficCar[];
export const TRAFFIC_SPAN: number;
export const SOLID_PROPS: (Box & { id: string })[];
export const OVERPASS: { x0: number; x1: number; z0: number; z1: number; y: number };
export const NPCS: Npc[];
export const TARGETS: Target[];
export const ROOMS: Record<string, Room>;
export function roomLayout(stage: string): RoomLayout | null;
export const WALKABLE_STAGES: Set<string>;
export const STAGES: Record<string, Stage>;
export const CAMERA_PRESETS: Preset[];
export const ROOM_PRESET: Preset;
export function streetFraming(target: Target, player: { x: number; z: number }): Shot;
export function colliders(): Box[];
export function insideBuilding(x: number, z: number, margin?: number): boolean;
export function isWalkable(x: number, z: number, boxes?: Box[], bounds?: Bounds): boolean;
export function angleBetween(from: number, to: number): number;
export function inputDirection(input: Partial<Input>, yaw: number): { heading: number; amount: number } | null;
export function stepPlayer(player: Player, input: Partial<Input>, dt: number, boxes?: Box[], bounds?: Bounds): Step;
export function followYaw(yaw: number, heading: number, speed: number, dt: number): number;
export function nearestTarget<T extends { x: number; z: number; radius?: number }>(player: { x: number; z: number }, targets?: T[]): T | null;
export function followCamera(player: Player, preset: Preset, yaw?: number, room?: Bounds | null): { x: number; y: number; z: number; look: { x: number; y: number; z: number } };
export function exitSpot(target: Target): Player;
export function toMinimap(x: number, z: number): { u: number; v: number };
export type Action = 'forward' | 'back' | 'left' | 'right' | 'sprint' | 'walk' | 'interact' | 'vehicle' | 'camera' | 'map';
export function keyAction(code: string): Action | null;
export function inputFrom(held: Set<string>): Input;
export function canUseKeys(target: EventTarget | null): boolean;
export function stepTraffic(cars: MovingCar[], player: { x: number; z: number }, dt: number, blockers?: { x: number; z: number }[]): MovingCar[];
