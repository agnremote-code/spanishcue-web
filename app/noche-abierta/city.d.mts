import type { Box, Bounds } from './world3d.mjs';

export type Rect = { x0: number; x1: number; z0: number; z1: number };
export type Road = Rect & { id: string; axis: 'x' | 'z' };
export type Ground = Rect & { id: string; kind: 'cobbles' | 'park' | 'stone' | 'market' | 'asphalt' | 'gravel' };
export type DistrictZone = Rect & { id: string; name: string; lamp: string; glow: string };
export type CityBuilding = Rect & {
  id: string; district: string; h: number; style: string; sign?: string;
  door?: { side: 'north' | 'south'; at: number }; balconies?: ('north' | 'south' | 'east' | 'west')[];
  canopy?: boolean; shutter?: 'north' | 'south'; fireEscape?: 'east' | 'west'; party?: boolean; clock?: boolean; flags?: boolean;
};
export type CityProp = Rect & { id: string; kind: string; h: number; color?: string };
export type Point = { x: number; z: number };
export type Placement = {
  x: number; z: number; y?: number; face: number; room?: string;
  circle: Point & { follow?: boolean };
  walk?: { from: Point; to: Point; speed: number };
  car?: Point & { heading: number }; kiosk?: Rect; boat?: Rect; poster?: Point & { y: number }; window?: (Point & { y: number }) | boolean;
  behindDoor?: boolean; behindCounter?: boolean; nobody?: boolean; seat?: boolean; balcony?: boolean;
};
export type StreetRoom = {
  district: string; label: string; origin: Point; size?: { w: number; d: number }; area?: Rect; height: number; roof?: number;
  door: Point; spawn: Point & { heading: number }; exit: Point & { radius: number }; solids: Rect[];
};
export type RoomDoor = { id: string; stage: string; x: number; z: number; radius: number; key: 'E'; verb: string; name: string };
export type StreetRoomLayout = {
  stage: string; roof: number; height: number; district: string; bounds: Bounds;
  spawn: Point & { heading: number }; exit: Point & { radius: number; id: string; key: 'E'; verb: string; exit: true }; solids: Rect[];
};
export type WalkerRoute = { id: string; points: [number, number][]; count: number };
export type Group = { id: string; x: number; z: number; size: number; district: string; uniform?: string; seated?: boolean; line?: boolean };
export type Sitter = Point & { id: string; face: number; tired?: boolean };
export type BalconyPerson = Point & { id: string; floor: number; face: number };
export type Animal = { id: string; species: 'cat' | 'dog'; x?: number; z?: number; y?: number; face?: number; route?: string; color: string; size?: 'small' | 'medium' };
export type CityTraffic = { id: string; road: string; axis: 'x' | 'z'; lane: number; dir: 1 | -1; start: number; speed: number; kind: string; color: string };
export type MovingVehicle = { id: string; axis?: 'x' | 'z'; road?: string; lane: number; dir: number; x: number; z: number; speed: number; cruise: number; kind?: string; color?: string };
export type Parked = Point & { id: string; kind: string; heading: number; color: string };
export type Walker = { id: string; route: string; animal?: 'cat' | 'dog'; s: number; offset: number; speed: number; pace: number; seed: number; x: number; z: number; heading: number; wait: number };
export type Spot = Point & { y?: number; face: number; seated?: boolean };
export type Standing = Spot & { id: string; seated?: boolean };
export type EmergencyRoute = { points: [number, number][]; stopAt: number; axis: 'x' | 'z'; dir: number };

export const CITY_BOUNDS: Bounds;
export const ROADS: Road[];
export const GROUNDS: Ground[];
export const CANAL: Rect & { bridges: { z0: number; z1: number }[] };
export const DISTRICT_ZONES: DistrictZone[];
export function districtAt(x: number, z: number): string;
export const CITY_BUILDINGS: CityBuilding[];
export const CITY_PROPS: CityProp[];
export const CEILINGS: (Rect & { id: string; height: number })[];
export const PLACEMENTS: Record<string, Placement>;
export const STREET_ROOMS: Record<string, StreetRoom>;
export const ROOM_DOORS: RoomDoor[];
export function streetRoomLayout(stage: string): StreetRoomLayout | null;
export function placementOf(id: string): (Placement & { y: number }) | null;
export const WALKER_ROUTES: WalkerRoute[];
export const GROUPS: Group[];
export const SITTERS: Sitter[];
export const BALCONY_PEOPLE: BalconyPerson[];
export const ANIMALS: Animal[];
export const CITY_TRAFFIC: CityTraffic[];
export const AMBULANCE_ROUTE: [number, number][];
export const AMBULANCE_EVERY: number;
export const CITY_PARKED: Parked[];
export const EDGES: (Rect & { id: string; kind: string; h: number })[];
export const BARRIERS: { id: string; x: number; z: number; axis: 'x' | 'z'; width: number }[];
export function lampPositions(): { x: number; z: number; arm: number; side?: boolean }[];
export const TREES: { x: number; z: number; kind: 'lime' | 'plane' | 'palm'; lights?: boolean }[];
export function castSpots(id: string, count: number): Spot[];
export function groupMembers(group: Group): Spot[];
export function standingPeople(castSizes?: Record<string, number>): Standing[];
export function canalWater(): (Rect & { water: true })[];
export function cityColliders(castSizes?: Record<string, number>): Box[];
export function trafficCar(entry: CityTraffic): MovingVehicle;
export const CROSSINGS: Rect[];
export function stepCityTraffic<T extends MovingVehicle>(cars: T[], people: Point[], dt: number, blockers?: (Point & { axis?: 'x' | 'z'; lane?: number; kind?: string })[], avenueSpan?: number): T[];
export function emergencyRoute(x: number, z: number): EmergencyRoute | null;
export function pathLength(points: [number, number][]): number;
export function pointOnPath(points: [number, number][], s: number): Point & { dx: number; dz: number };
export function makeWalkers(): Walker[];
export function stepWalkers(walkers: Walker[], standing: Point[], cars: MovingVehicle[], dt: number, boxes: Rect[]): Walker[];
export function routeOf(id: string): WalkerRoute | null;
