import type { Beat, Circle, Route, RouteStep } from './levels.d.mts';
export type BeatState = { tries: number[]; pick: number | null; seen: boolean };
export type SceneState = { id: string; beats: Record<string, BeatState> };
export type State = { level: string; route: 'conversacion' | 'escucha'; done: Record<string, string[]>; scene: SceneState | null };
export type Tick = 'logrado' | 'con-ayuda' | 'todavia';
export type Session = { ticks: Record<string, Tick>; picks: Record<string, number>; order: string[]; checks: string[]; finished: boolean };
export const STORAGE_KEY: string;
export const SESSION_KEY: string;
export const LEVEL_IDS: string[];
export const DEFAULT_LEVEL: string;
export const TICKS: Tick[];
export const TICK_LABEL: Record<Tick, string>;
export const LESSON_ID: number;
export function normaliseLevel(value: unknown): string | null;
export function createState(level?: string): State;
export function doneFor(state: State, level?: string): string[];
export function openScene(state: State, id: string): State;
export function closeScene(state: State): State;
export function markDone(state: State, id: string): State;
export function beatDone(scene: SceneState | null, beat: Beat, session?: Session): boolean;
export function currentBeat(scene: SceneState | null, circle: Circle | undefined, session?: Session): number;
export function answerBeat(state: State, beat: Beat, index?: number): State;
export function lastFeedback(scene: SceneState | null, beat: Beat): { text: string; correct: boolean; feature: string | null } | null;
export function timelinePick(scene: SceneState | null, circle: Circle | undefined): number | null;
export function settleScene(state: State, session: Session, circles: Record<string, Circle>): { state: State; session: Session };
export function setRoute(state: State, route: string): State;
export function resetLevel(state: State): State;
export function serialise(state: State): string;
export function restore(raw: string | null): State;
export function createSession(): Session;
export function restoreSession(raw: string | null): Session;
export function serialiseSession(session: Session): string;
export function resetGroup(): Session;
export function tick(session: Session, id: string, value: Tick): Session;
export function recordPick(session: Session, id: string, index: number): Session;
export function toggleCheck(session: Session, id: string): Session;
export function finish(session: Session): Session;
export function tally(session: Session, ids?: string[]): { logrado: number; ticked: number; total: number };
export function routeSteps(route: Route | undefined): RouteStep[];
export function routeCircles(route: Route | undefined): string[];
export function stepDone(step: RouteStep, done: string[]): boolean;
export function routeProgress(route: Route | undefined, done: string[], finished: boolean): number;
export function timeline(session: Session, circles: Record<string, Circle>): { id: string; text: string }[];
export function ambienceGain(opts?: { clip?: boolean; card?: boolean }): number;
export function worldPaused(opts?: { card?: boolean; intro?: boolean; list?: boolean }): boolean;
