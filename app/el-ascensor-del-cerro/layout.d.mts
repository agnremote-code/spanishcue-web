export type TerraceId = 'puerto' | 'medio' | 'alto';
export type Terrace = { id: TerraceId; name: string; short: string; y: number; z0: number; z1: number };
export type Circle = { id: string; n: number; name: string; place: string; terrace: TerraceId; spot: { x: number; z: number }; npc: { x: number; z: number } };
export type Box = { x0: number; x1: number; z0: number; z1: number; top?: number; pole?: boolean; slope?: string };
export type Link = {
  id: string; kind: 'funicular' | 'escalera'; label: string; from: TerraceId; to: TerraceId;
  at: { x: number; z: number }; enter: number; exit: { x: number; z: number; heading: number }; path?: [number, number, number][];
};
export type RidePose = { x: number; y: number; z: number; heading: number; cabin: number | null };
export type Building = { x0: number; x1: number; z0: number; z1: number; h: number; color: string };
export const BOUNDS: { minX: number; maxX: number; minZ: number; maxZ: number };
export const SPAWN: { x: number; z: number; heading: number };
export const SPOT_RADIUS: number;
export const LINK_RADIUS: number;
export const TERRACES: Terrace[];
export function terraceById(id: string): Terrace | null;
export function terraceAt(x: number, z: number): Terrace;
export function groundY(x: number, z: number): number;
export const CIRCLES: Circle[];
export const CIRCLE_IDS: string[];
export const CIRCLES_BY_HEIGHT: Circle[];
export function circleById(id: string): Circle | null;
export const FUNICULAR: { rails: [number, number]; bottom: { z: number; y: number }; top: { z: number; y: number }; chassis: number; seconds: number };
export function cabinAt(s: number, rail?: number): { x: number; y: number; z: number };
export const TRACK_ANGLE: number;
export const STAIRS: { x: number; width: number; flights: { z0: number; y0: number; z1: number; y1: number }[] };
export const LINKS: Link[];
export function linkById(id: string): Link | null;
export function linkAt(x: number, z: number): string | null;
export function walksInto(link: Link | null, heading: number, speed: number): boolean;
export function rideSeconds(link: string | Link): number;
export function ridePose(link: string | Link, t: number, rail?: number): RidePose | null;
export const POLES: { x: number; z: number }[];
export const TREES: { x: number; z: number }[];
export const BOLLARDS: { x: number; z: number }[];
export const BUILDINGS: Record<'estacionBaja' | 'estacionAlta' | 'cafe' | 'taller' | 'asamblea' | 'kiosco' | 'contenedores', Building>;
export function solids(): Box[];
export const SOLIDS: Box[];
export function isFree(x: number, z: number, radius?: number, boxes?: Box[]): boolean;
export function isClearGround(x: number, z: number, radius?: number, boxes?: Box[]): boolean;
export function spotAt(x: number, z: number): string | null;
export function framing(id: string): { x: number; z: number; heading: number } | null;
export function arrival(id: string): { x: number; z: number; heading: number };
export const TERRACE_ARRIVAL: Record<TerraceId, { x: number; z: number; heading: number }>;
export type CrowdPerson = { x: number; z: number; heading: number; seed: number; pose: string };
export const CROWD: CrowdPerson[];
export function crowd(count?: number): CrowdPerson[];
export function circleStep(circle: { inside: string | null; still: number; spent: string | null }, here: string | null, opened: string | null, speed: number, dt: number): { inside: string | null; still: number; spent: string | null; open: string | null };
export function clampCamera(px: number, pz: number, cx: number, cy: number, cz: number): { x: number; y: number; z: number };
