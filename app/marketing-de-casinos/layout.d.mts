import type { Look } from '../noche-abierta/people3d';
export type Bounds = { minX: number; maxX: number; minZ: number; maxZ: number };
export type Box = { x0: number; x1: number; z0: number; z1: number };
export type Floor = { id: number; name: string; sub: string; y: number; bounds: Bounds };
export type Placed = { x: number; z: number; heading: number };
export type Extra = Placed & { pose: string; mood?: string; look: Look; smoke?: boolean; cigar?: boolean; piano?: boolean };
export type Scene = {
  id: string; floor: number; place: string; name: string; role: string;
  spot: { x: number; z: number }; npc: Placed; pose: string; mood?: string; look: Look; smoke?: boolean; cigar?: boolean; extras?: Extra[];
};
export type Furniture = { type: string; x: number; z: number; w: number; d: number; rot?: number; solid?: boolean };
export type CrowdMember = Placed & { pose: string; y?: number; smoke?: boolean; walk?: { axis: 'x' | 'z'; from: number; to: number; speed: number } };
export const FLOOR_H: number;
export const CEILING: number;
export const WALL: number;
export const FLOORS: Floor[];
export function floorById(id: number): Floor;
export const SPAWN: Placed & { floor: number };
export const ELEVATOR: { x: number; z: number; radius: number; doors: number[]; wallZ: number };
export const ELEVATOR_ARRIVAL: Placed;
export const WALLS: Record<number, number[][]>;
export const FURNITURE: Record<number, Furniture[]>;
export const SCENES: Scene[];
export const SCENE_IDS: string[];
export function sceneById(id: string): Scene | undefined;
export const SPOT_RADIUS: number;
export const HEROINE: { name: string; look: Look };
export const CROWD: Record<number, CrowdMember[]>;
export function footprint(item: Furniture): Box;
export function wallBox(segment: number[]): Box;
export function solidsFor(floor: number): Box[];
export function spotAt(floor: number, x: number, z: number, radius?: number): string | null;
export function atElevator(x: number, z: number): boolean;
export function nextSpot(floor: number, x: number, z: number, done?: string[]): Scene | null;
export function sceneFraming(scene: Scene): Placed;
export function cameraBlockers(floor: number): Box[];
