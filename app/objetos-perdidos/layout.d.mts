export function sectorAt(x: number, z: number): Sector | null;
export const WALLS: Wall[];
export const DOORS: Door[];
export const TELEPORTS: Teleport[];
export function teleportTarget(id: string): Placed | null;
export function teleportAt(x: number, z: number): string | null;
export function teleportStep(armed: boolean, x: number, z: number): { armed: boolean; go: Placed | null };
export const ROWS: Row[];
export const ROW_SEAT: number;
