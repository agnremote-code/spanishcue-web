import type { Look } from '../noche-abierta/people3d';
import type { StoryScene } from './story.d.mts';
import type { CharlaPlace } from '../charlas-3d/lugar';
export type Bounds = { minX: number; maxX: number; minZ: number; maxZ: number };
export type Box = { x0: number; x1: number; z0: number; z1: number; top?: number; prop?: string; person?: boolean; void?: boolean };
export type Rect = { x0: number; z0: number; x1: number; z1: number };
export type Placed = { x: number; z: number; heading: number };
export type Person = Placed & { pose: string; mood?: string; look: Look; seat?: boolean; lying?: boolean; y?: number };
export type Scene = StoryScene & { spot: { x: number; z: number }; npc: Placed & { seat?: boolean; lying?: boolean; y?: number }; pose: string; mood?: string; look: Look; extras?: Person[] };
export type Sector = Rect & { id: string; name: string; sound: string };
export type Door = { x: number; z: number; w: number; label: string; out?: boolean };
export type Teleport = { id: string; label: string; x: number; z: number; r: number; to: Placed; goes: string };
export type Furniture = { type: string; x: number; z: number; w: number; d: number; rot?: number; solid?: boolean };
export type Walker = { look: Look; path: [number, number][]; speed: number; pause?: number; delay?: number; mop?: boolean };
export type CrowdMember = Placed & { pose: string; mood?: string; seat?: boolean; y?: number };
export type Wall = [number, number, number, number, string];
export type Row = { x: number; z: number; w: number };
export const WALL: number;
export const BOUNDS: Bounds;
export const STREET: Rect;
export const BUILDING: Rect;
export const HALL: Rect;
export const OFFICE_ROOM: Rect;
