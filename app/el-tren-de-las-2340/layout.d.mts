import type { Look } from '../noche-abierta/people3d';
import type { StoryScene } from './story.d.mts';
export type Bounds = { minX: number; maxX: number; minZ: number; maxZ: number };
export type Box = { x0: number; x1: number; z0: number; z1: number; top?: number };
export type Floor = { id: number; name: string; sub: string; kind: 'car' | 'platform'; y: number; bounds: Bounds };
export type Placed = { x: number; z: number; heading: number };
export type Person = Placed & { pose: string; mood?: string; look: Look; seat?: boolean; lying?: boolean; y?: number };
export type Scene = StoryScene & { spot: { x: number; z: number }; npc: Placed & { seat?: boolean; lying?: boolean; y?: number }; pose: string; mood?: string; look: Look; extras?: Person[] };
export type Sector = { floor: number; id: string; name: string; x0: number; z0: number; x1: number; z1: number; sound: string; light: string };
export type Portal = { id: 'front' | 'back' | 'door'; x: number; z: number; radius: number; arrive: Placed };
export type Furniture = { type: string; x: number; z: number; w: number; d: number; rot?: number; solid?: boolean; label?: string; top?: number; on?: number; side?: number; place?: string; text?: string; time?: string; door?: number; empty?: boolean; open?: boolean };
export type Walker = { look: Look; path: [number, number][]; speed: number; pause?: number; delay?: number };
export type CrowdMember = Placed & { pose: string; mood?: string; seat?: boolean; lying?: boolean; child?: boolean };
export const CEILING: number;
export const WALL: number;
export const HALF: number;
export const FLOORS: Floor[];
export const FLOOR_IDS: number[];
export const FLOOR_LABEL: Record<number, string>;
export function floorById(id: number): Floor;
export function isCar(floor: number): boolean;
export function OPEN_AIR(floor: number): boolean;
export const TRAIN_ORDER: number[];
export const SPAWN: Placed & { floor: number };
export function doorZ(floor: number): number;
export function portalsFor(floor: number): Portal[];
export const PORTALS: Record<number, Portal[]>;
export function portalAt(floor: number, x: number, z: number): Portal | null;
export function arrivalFor(from: number, to: number): Placed;
export const ARRIVALS: (Placed & { floor: number; id: string })[];
export const CABIN: { z0: number; z1: number; w: number; first: number };
export function cabinX0(car: number, n: number): number;
export const OPEN_CABINS: Record<number, number[]>;
export function cabinAt(floor: number, x: number, z: number): number | null;
export const SECTORS: Sector[];
export function sectorAt(floor: number, x: number, z: number): Sector | null;
export const WALLS: Record<number, (number | string)[][]>;
export const DINING_TABLES: number[];
export const FURNITURE: Record<number, Furniture[]>;
export const LOOKS: Record<string, Look>;
export const SCENES: Scene[];
export const SCENE_IDS: string[];
export function sceneById(id: string): Scene | undefined;
export const SPOT_RADIUS: number;
export const WALKERS: Record<number, Walker[]>;
export const CROWD: Record<number, CrowdMember[]>;
export const CHATTER: Record<number, string[]>;
export const ANNOUNCEMENTS: string[];
export function footprint(item: Furniture): Box;
export function wallBox(seg: (number | string)[]): Box;
export function topOf(item: Furniture): number | null;
export function cameraBlockers(floor: number): Box[];
export function solidsFor(floor: number): Box[];
export function spotAt(floor: number, x: number, z: number, radius?: number): string | null;
export function nextSpot(floor: number, x: number, z: number, done?: string[]): Scene | null;
export function sceneFraming(scene: Scene): Placed;
export function sceneCamera(scene: Scene, player?: { x: number; z: number }): { x: number; z: number; look: { x: number; z: number }; seen: number; faces: number; room: number };
export function circleStep(circle: { inside: string | null; still: number; spent: string | null }, here: string | null, opened: string | null, speed: number, dt: number): { inside: string | null; still: number; spent: string | null; open: string | null };
export function walkerAt(walker: Walker, t: number): Placed & { moving: boolean };
