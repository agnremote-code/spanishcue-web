{
  "note": "Short shouted lines for every 3D world: what a person yells when the mascot crashes into them (bump) and the cries heard in the hospital (cry). Each line is spoken by a native neural voice from the country whose Spanish it uses (never the multilingual English or German voices of the listenings: they gave the insults a foreign accent). Every bump voice has four lines; a person keeps one voice and says another line at each crash. Audio: /audio/escucha-3d/voces-<id>.mp3, built by scripts/generate-escucha-3d-audio.py.",
  "lines": [
    { "id": "ar-m", "kind": "bump", "body": "m", "voice": "es-AR-TomasNeural", "text": "¡Correte, mierda! ¿No ves que estoy acá?" },
    { "id": "ar-m-2", "kind": "bump", "body": "m", "voice": "es-AR-TomasNeural", "text": "¡Eh, flaco! ¿Estás ciego o qué?" },
    { "id": "ar-m-3", "kind": "bump", "body": "m", "voice": "es-AR-TomasNeural", "text": "¡La puta madre, me pisaste!" },
    { "id": "ar-m-4", "kind": "bump", "body": "m", "voice": "es-AR-TomasNeural", "text": "¡Pará un poco, boludo, que no estás solo!" },
    { "id": "ar-f", "kind": "bump", "body": "f", "voice": "es-AR-ElenaNeural", "text": "¡Correte, pelotudo! ¡Mirá por dónde caminás!" },
    { "id": "ar-f-2", "kind": "bump", "body": "f", "voice": "es-AR-ElenaNeural", "text": "¡Ay, nene, qué bestia! ¡Casi me tirás!" },
    { "id": "ar-f-3", "kind": "bump", "body": "f", "voice": "es-AR-ElenaNeural", "text": "¡Qué tarado, por favor! ¡Fijate!" },
    { "id": "ar-f-4", "kind": "bump", "body": "f", "voice": "es-AR-ElenaNeural", "text": "¡Ma sí, andá a cagar!" },
    { "id": "es-m", "kind": "bump", "body": "m", "voice": "es-ES-AlvaroNeural", "text": "¡Quítate de en medio, joder! ¡Gilipollas!" },
    { "id": "es-m-2", "kind": "bump", "body": "m", "voice": "es-ES-AlvaroNeural", "text": "¡Me cago en la leche! ¡Mira por dónde vas!" },
    { "id": "es-m-3", "kind": "bump", "body": "m", "voice": "es-ES-AlvaroNeural", "text": "¡Tío, que me has dado un golpe de narices!" },
    { "id": "es-m-4", "kind": "bump", "body": "m", "voice": "es-ES-AlvaroNeural", "text": "¡Venga, hombre, aparta ya, coño!" },
    { "id": "es-f", "kind": "bump", "body": "f", "voice": "es-ES-ElviraNeural", "text": "¡Pero mira por dónde vas, imbécil!" },
    { "id": "es-f-2", "kind": "bump", "body": "f", "voice": "es-ES-ElviraNeural", "text": "¡Hala, qué bruto! ¡Que me tiras!" },
    { "id": "es-f-3", "kind": "bump", "body": "f", "voice": "es-ES-ElviraNeural", "text": "¡Pero bueno, tía, que no estás sola!" },
    { "id": "es-f-4", "kind": "bump", "body": "f", "voice": "es-ES-ElviraNeural", "text": "¡Vaya tela! ¡Ten más cuidado, hombre!" },
    { "id": "mx-m", "kind": "bump", "body": "m", "voice": "es-MX-JorgeNeural", "text": "¡Hazte a un lado, pendejo! ¡Casi me tiras!" },
    { "id": "mx-m-2", "kind": "bump", "body": "m", "voice": "es-MX-JorgeNeural", "text": "¡No manches, güey! ¡Fíjate!" },
    { "id": "mx-m-3", "kind": "bump", "body": "m", "voice": "es-MX-JorgeNeural", "text": "¡Órale, cabrón! ¡Me tumbaste el café!" },
    { "id": "mx-m-4", "kind": "bump", "body": "m", "voice": "es-MX-JorgeNeural", "text": "¡Ándale, quítate de ahí, carnal!" },
    { "id": "mx-f", "kind": "bump", "body": "f", "voice": "es-MX-DaliaNeural", "text": "¡Fíjate, menso! ¡Qué te pasa!" },
    { "id": "mx-f-2", "kind": "bump", "body": "f", "voice": "es-MX-DaliaNeural", "text": "¡Ay, qué onda contigo! ¡Me lastimaste!" },
    { "id": "mx-f-3", "kind": "bump", "body": "f", "voice": "es-MX-DaliaNeural", "text": "¡Ash, qué menso eres, de veras!" },
    { "id": "mx-f-4", "kind": "bump", "body": "f", "voice": "es-MX-DaliaNeural", "text": "¡Híjole, fíjate tantito, oye!" },
    { "id": "co-m", "kind": "bump", "body": "m", "voice": "es-CO-GonzaloNeural", "text": "¡Quítese, pues, güevón! ¡Qué animal!" },
    { "id": "co-m-2", "kind": "bump", "body": "m", "voice": "es-CO-GonzaloNeural", "text": "¡Uy, parce, qué chimbada! ¡Me pisó!" },
    { "id": "co-m-3", "kind": "bump", "body": "m", "voice": "es-CO-GonzaloNeural", "text": "¡Vea pues, no sea tan bruto, hermano!" },
    { "id": "co-m-4", "kind": "bump", "body": "m", "voice": "es-CO-GonzaloNeural", "text": "¡Ábrase, gonorrea, que voy de afán!" },
    { "id": "co-f", "kind": "bump", "body": "f", "voice": "es-CO-SalomeNeural", "text": "¡Ay, qué bruto! ¡Mire por dónde camina!" },
    { "id": "co-f-2", "kind": "bump", "body": "f", "voice": "es-CO-SalomeNeural", "text": "¡Ay, no, qué pereza con usted!" },
    { "id": "co-f-3", "kind": "bump", "body": "f", "voice": "es-CO-SalomeNeural", "text": "¡Juemadre, casi me tumba!" },
    { "id": "co-f-4", "kind": "bump", "body": "f", "voice": "es-CO-SalomeNeural", "text": "¡Uy, tan de buenas usted! ¿Sí o qué?" },
    { "id": "cl-m", "kind": "bump", "body": "m", "voice": "es-CL-LorenzoNeural", "text": "¡Sale de ahí, weón! ¡Fíjate!" },
    { "id": "cl-m-2", "kind": "bump", "body": "m", "voice": "es-CL-LorenzoNeural", "text": "¡Puta la weá, me botaste todo!" },
    { "id": "cl-m-3", "kind": "bump", "body": "m", "voice": "es-CL-LorenzoNeural", "text": "¡Ya po, hueón, fíjate dónde caminai!" },
    { "id": "cl-m-4", "kind": "bump", "body": "m", "voice": "es-CL-LorenzoNeural", "text": "¡Qué onda, compadre! ¡Más cuidado!" },
    { "id": "cl-f", "kind": "bump", "body": "f", "voice": "es-CL-CatalinaNeural", "text": "¡Oye, idiota! ¡Me pisaste!" },
    { "id": "cl-f-2", "kind": "bump", "body": "f", "voice": "es-CL-CatalinaNeural", "text": "¡Ay, qué lata, me pegaste fuerte!" },
    { "id": "cl-f-3", "kind": "bump", "body": "f", "voice": "es-CL-CatalinaNeural", "text": "¡Oye, cabro, mira por dónde vai!" },
    { "id": "cl-f-4", "kind": "bump", "body": "f", "voice": "es-CL-CatalinaNeural", "text": "¡Chuta, casi me caigo por tu culpa!" },
    { "id": "cu-m", "kind": "bump", "body": "m", "voice": "es-CU-ManuelNeural", "text": "¡Asere, quítate del medio, coño!" },
    { "id": "cu-m-2", "kind": "bump", "body": "m", "voice": "es-CU-ManuelNeural", "text": "¡Oye, mi hermano, qué tú haces!" },
    { "id": "cu-m-3", "kind": "bump", "body": "m", "voice": "es-CU-ManuelNeural", "text": "¡Coño, compadre, me fastidiaste el pie!" },
    { "id": "cu-m-4", "kind": "bump", "body": "m", "voice": "es-CU-ManuelNeural", "text": "¡Pero acere, mira por dónde caminas!" },
    { "id": "cu-f", "kind": "bump", "body": "f", "voice": "es-CU-BelkysNeural", "text": "¡Muchacho, qué bruto eres! ¡Mira bien!" },
    { "id": "cu-f-2", "kind": "bump", "body": "f", "voice": "es-CU-BelkysNeural", "text": "¡Ay, mi madre, qué bruto este!" },
    { "id": "cu-f-3", "kind": "bump", "body": "f", "voice": "es-CU-BelkysNeural", "text": "¡Mijo, pero tú estás ciego o qué!" },
    { "id": "cu-f-4", "kind": "bump", "body": "f", "voice": "es-CU-BelkysNeural", "text": "¡Qué clase de animal, caballero!" },
    { "id": "ve-m", "kind": "bump", "body": "m", "voice": "es-VE-SebastianNeural", "text": "¡Epa, chamo! ¡Quítate, coño!" },
    { "id": "ve-m-2", "kind": "bump", "body": "m", "voice": "es-VE-SebastianNeural", "text": "¡Na guará, chamo, me pisaste!" },
    { "id": "ve-m-3", "kind": "bump", "body": "m", "voice": "es-VE-SebastianNeural", "text": "¡Vale, mi pana, ten más cuidado!" },
    { "id": "ve-m-4", "kind": "bump", "body": "m", "voice": "es-VE-SebastianNeural", "text": "¡Qué ladilla, vale! ¡Quítate de ahí!" },
    { "id": "ve-f", "kind": "bump", "body": "f", "voice": "es-VE-PaolaNeural", "text": "¡Pendiente, pues, animal!" },
    { "id": "ve-f-2", "kind": "bump", "body": "f", "voice": "es-VE-PaolaNeural", "text": "¡Ay, chamo, qué bolsa eres!" },
    { "id": "ve-f-3", "kind": "bump", "body": "f", "voice": "es-VE-PaolaNeural", "text": "¡Epa, mosca, que me tumbas!" },
    { "id": "ve-f-4", "kind": "bump", "body": "f", "voice": "es-VE-PaolaNeural", "text": "¡Pero mira, vale, qué falta de respeto!" },
    { "id": "pe-m", "kind": "bump", "body": "m", "voice": "es-PE-AlexNeural", "text": "¡Oe, muévete, pe! ¡Qué te pasa!" },
    { "id": "pe-m-2", "kind": "bump", "body": "m", "voice": "es-PE-AlexNeural", "text": "¡Asu mare, causa, me chancaste!" },
    { "id": "pe-m-3", "kind": "bump", "body": "m", "voice": "es-PE-AlexNeural", "text": "¡Oe, compadre, fíjate pues!" },
    { "id": "pe-m-4", "kind": "bump", "body": "m", "voice": "es-PE-AlexNeural", "text": "¡Qué fue, choche! ¡Más cuidado, pe!" },
    { "id": "pe-f", "kind": "bump", "body": "f", "voice": "es-PE-CamilaNeural", "text": "¡Ay, fíjate, oye, sonso!" },
    { "id": "pe-f-2", "kind": "bump", "body": "f", "voice": "es-PE-CamilaNeural", "text": "¡Ay, qué palta, me empujaste!" },
    { "id": "pe-f-3", "kind": "bump", "body": "f", "voice": "es-PE-CamilaNeural", "text": "¡Oye, no seas bruto, pues!" },
    { "id": "pe-f-4", "kind": "bump", "body": "f", "voice": "es-PE-CamilaNeural", "text": "¡Uy, qué tal concha, ah!" },
    { "id": "grito-1", "kind": "cry", "body": "f", "voice": "es-UY-ValentinaNeural", "text": "¡Socorro! ¡Que alguien me ayude!" },
    { "id": "grito-2", "kind": "cry", "body": "m", "voice": "es-DO-EmilioNeural", "text": "¡Doctor! ¡Doctor! ¡Se está muriendo!" },
    { "id": "grito-3", "kind": "cry", "body": "f", "voice": "es-PR-KarinaNeural", "text": "¡Ay, mi pierna! ¡Ay, Dios mío!" },
    { "id": "grito-4", "kind": "cry", "body": "m", "voice": "es-BO-MarceloNeural", "text": "¡Se escapó el de la cama doce! ¡Agárrenlo!" },
    { "id": "grito-5", "kind": "cry", "body": "f", "voice": "es-EC-AndreaNeural", "text": "¡Ya viene! ¡El bebé ya viene!" },
    { "id": "grito-6", "kind": "cry", "body": "m", "voice": "es-PY-MarioNeural", "text": "¡Paso, paso! ¡Abran paso, que se nos va!" }
  ]
}
