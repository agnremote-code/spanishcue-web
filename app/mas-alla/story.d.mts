export type WorldId = 'cielo' | 'infierno';
export type World = { id: WorldId; name: string; sign: string; hook: string };
export type Zone = { id: string; world: WorldId; name: string; hook: string };
export type Kind = 'angel' | 'demon' | 'soul';
export type CastMember = { name: string; full: string; role: string; kind: Kind; gender: 'f' | 'm'; voice: string; country: string; look: Record<string, unknown> };
export type FormId = 'balanza' | 'velas' | 'libros' | 'rio' | 'estrellas' | 'cartas' | 'puertas' | 'espejo' | 'matriz' | 'monedas' | 'cadenas' | 'reloj';
export type Spot = { id: string; zone: string; world: WorldId; cast: string[]; form: FormId };
export const WORLDS: World[];
export const WORLD_IDS: WorldId[];
export const ZONES: Zone[];
export const ZONE_IDS: string[];
export function zoneById(id: string): Zone | null;
export const CAST: Record<string, CastMember>;
export const FORMS: Record<FormId, { options: number; label: string; hint: string }>;
export const SPOTS: Spot[];
export const SPOT_IDS: string[];
export function spotById(id: string): Spot | null;
export function spotsOf(world: string): Spot[];
export const LEVEL_IDS: string[];
export const SCENE_WORDS: Record<string, [number, number]>;
export const TALK_MIN_WORDS: Record<string, number>;
