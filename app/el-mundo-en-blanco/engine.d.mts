import type { Spot } from './story.mjs';
export type Level = 'A0' | 'A1' | 'A2' | 'B1' | 'B2' | 'C1' | 'C2';
export type Ending = 'guardar' | 'regalar' | 'seguir';
export type State = { level: Level; done: Partial<Record<Level, string[]>>; answers: Partial<Record<Level, Record<string, number>>>; ending: Partial<Record<Level, Ending>>; arrived: boolean };
export const STORAGE_KEY: string;
export const DEFAULT_LEVEL: Level;
export const ENDINGS: Ending[];
export function normaliseLevel(value: unknown): Level | null;
export function createState(level?: string): State;
export function restore(raw: unknown): State;
export function serialise(state: State): string;
export function setLevel(state: State, level: string): State;
export function arrive(state: State): State;
export function doneFor(state: State, level?: Level): string[];
export function answersFor(state: State, level?: Level): Record<string, number>;
export function isDone(state: State, spot: string, level?: Level): boolean;
export function zoneDone(state: State, zone: string, level?: Level): number;
export function inkOf(state: State, level?: Level): number;
export function answer(state: State, spot: string, index: number): State;
export function markDone(state: State, spot: string): State;
export function decide(state: State, ending: string): State;
export function resetLevel(state: State): State;
export function nextSpot(state: State, spot: string): Spot | null;
export function toSaved(state: State): { values: Record<string, unknown>; results: Record<string, string[]>; pos: { stage: number; step: number } };
export function fromSaved(saved: unknown): State;
