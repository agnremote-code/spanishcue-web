export type Level = 'A0' | 'A1' | 'A2' | 'B1' | 'B2' | 'C1' | 'C2';
export type State = { level: Level; zone: string; done: Partial<Record<Level, string[]>>; arrived: boolean; ended: Partial<Record<Level, boolean>> };
export type Saved = { values: Record<string, unknown>; results: Record<string, unknown>; pos: { stage: number; step: number } };
export const STORAGE_KEY: string;
export const DEFAULT_LEVEL: Level;
export const ZONE_IDS: string[];
export const ALL_KEYS: string[];
export const CIRCLE_KEYS: string[];
export const STREET_KEYS: string[];
export function circlesDone(state: State, level?: Level): string[];
export function streetDone(state: State, level?: Level): string[];
export function spotKey(zone: string, spot: string): string;
export function normaliseLevel(value: unknown): Level | null;
export function createState(level?: string): State;
export function restore(raw: unknown): State;
export function serialise(state: State): string;
export function setLevel(state: State, level: string): State;
export function setZone(state: State, zone: string): State;
export function arrive(state: State): State;
export function doneFor(state: State, level?: Level): string[];
export function isDone(state: State, zone: string, spot: string, level?: Level): boolean;
export function markDone(state: State, zone: string, spot: string): State;
export function endMission(state: State): State;
export function resetLevel(state: State): State;
export function zoneCount(state: State): Record<string, number>;
export function clearedZones(state: State): string[];
export function nextSpot(state: State, zone: string, spot: string): { zone: string; spot: string } | null;
export function toSaved(state: State): Saved;
export function fromSaved(saved: unknown): State;
