import type { Look } from '../noche-abierta/people3d';
import type { StoryScene } from './story.d.mts';
export type Bounds = { minX: number; maxX: number; minZ: number; maxZ: number };
export type Box = { x0: number; x1: number; z0: number; z1: number; top?: number; prop?: string; water?: boolean };
export type Rect = { x0: number; z0: number; x1: number; z1: number };
export type Placed = { x: number; z: number; heading: number };
export type Person = Placed & { pose: string; mood?: string; look: Look; seat?: boolean; lying?: boolean; y?: number };
export type Scene = StoryScene & { spot: { x: number; z: number }; npc: Placed & { seat?: boolean; lying?: boolean; y?: number }; pose: string; mood?: string; look: Look; extras?: Person[] };
export type Sector = Rect & { id: string; name: string; sound: string };
export type Door = { x: number; z: number; w: number; label?: string };
export type Furniture = { type: string; x: number; z: number; w: number; d: number; rot?: number; solid?: boolean; label?: string; top?: number; color?: string; open?: boolean; kind?: string };
export type Walker = { look: Look; path: [number, number][]; speed: number; pause?: number; delay?: number; tray?: boolean };
export type CrowdMember = Placed & { pose: string; mood?: string; seat?: boolean; lying?: boolean; mariachi?: boolean; y?: number };
export type Wall = [number, number, number, number, string];
export const WALL: number;
export const HOUSE_H: number;
export const CHAPEL_H: number;
export const BOUNDS: Bounds;
export const SPAWN: Placed;
export const CHAPEL: Rect & { door: [number, number] };
export const HOUSE: Rect & { porch: number };
export const TENT: Rect & { h: number; ridge: number };
export const BARN: Rect;
export const POND: { x: number; z: number; rx: number; rz: number };
export const JETTY: Rect;
export const DANCE: Rect;
export const STAGE: Rect & { top: number };
export function ceilingAt(x: number, z: number): number;
export function roofed(x: number, z: number): boolean;
export const SECTORS: Sector[];
export function sectorAt(x: number, z: number): Sector | null;
export const WALLS: Wall[];
export const DOORS: Door[];
export const TABLES: { x: number; z: number }[];
export const TABLE_LEN: number;
export function chairX(i: number): number;
export const ROUND: { x: number; z: number }[];
export const SEAT_R: number;
export function roundSeat(t: { x: number; z: number }, k: number): Placed;
export const FURNITURE: Furniture[];
export const SCENES: Scene[];
export const SCENE_IDS: string[];
export function sceneById(id: string): Scene | undefined;
export const SPOT_RADIUS: number;
export const CROWD: CrowdMember[];
export const FILLERS: CrowdMember[];
export const WALKERS: Walker[];
export const CHATTER: string[];
export const ANNOUNCEMENTS: string[];
export function footprint(item: Furniture): Box;
export function wallBox(segment: Wall): Box;
export function pondBoxes(): Box[];
export function topOf(item: Furniture): number | null;
export function cameraBlockers(): Box[];
export function solidsFor(): Box[];
export function spotAt(x: number, z: number, radius?: number): string | null;
export function nextSpot(x: number, z: number, done?: string[]): Scene | null;
export function sceneFraming(scene: Scene): Placed;
export type Circle = { inside: string | null; still: number; spent: string | null };
export function circleStep(circle: Circle, here: string | null, opened: string | null, speed: number, dt: number): Circle & { open: string | null };
export function walkerAt(walker: Walker, t: number): Placed & { moving: boolean };
