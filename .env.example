# Optional runtime overrides. The current owner values remain as safe fallbacks
# until these are configured in the hosting environment.
CHESPANISH_OWNER_UID=
CHESPANISH_OWNER_EMAIL=
CHESPANISH_APPLE_AUTH_ENABLED=false

# Server-only verification delivery. Configure real values in Sites secrets.
# The Firebase value is the complete service-account JSON encoded as Base64.
RESEND_API_KEY=
FIREBASE_ADMIN_SERVICE_ACCOUNT_B64=

# Firebase browser configuration is public by design. Keep the values in
# app/firebase-config.ts for the current Sites build; use these names when the
# project is moved to a host that injects NEXT_PUBLIC_* values at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional direct GA4 web measurement. Leave blank to disable all GA4 loading.
# This must be a Measurement ID (G-...), never a GTM container ID or API secret.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Server-only production gate for first-paid conversion events. Keep false for
# sandbox, tests and internal validation; set true only after verifying GA4
# internal-traffic filters in the live property.
ANALYTICS_CONVERSIONS_ENABLED=false

# Legal operator. Preferred launch configuration: one server-only JSON secret.
# The legacy LEGAL_* fields remain supported as a compatibility fallback.
LEGAL_OPERATOR_JSON=

# PayPal subscriptions. Keep these only in the hosted server runtime; never
# expose the secret in NEXT_PUBLIC_* variables or commit a real value.
PAYPAL_ENV=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_SANDBOX_PRODUCT_ID=
PAYPAL_SANDBOX_FOUNDER_PLAN_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_PRODUCT_ID=
PAYPAL_LIVE_FOUNDER_PLAN_ID=
# Keep false for launch preparation. A single internal account can perform the
# supervised Live purchase without exposing checkout to the public.
PAYPAL_PUBLIC_CHECKOUT_ENABLED=false
PAYPAL_LIVE_SUPERVISED_USER_ID=

# Central commercial configuration. The source of truth for the actual
# availability is D1, not this display configuration.
FOUNDER_OFFER_ENABLED=true
FOUNDER_OFFER_CODE=founder-1000-usd15-monthly
FOUNDER_LIMIT=1000
FOUNDER_PRICE_USD=15
