      "path": "app/grammar-classroom/live/lessons/g239.ts",
      "text": "This is your first Spanish class. By the end you can say who you are, how you are and where you are: your first message to your grandparents."
    },
    {
      "path": "app/grammar-classroom/live/lessons/g239.ts",
      "text": "Hi, grandma. I am Alex."
