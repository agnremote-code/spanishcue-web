      {
        "before": "  assert.equal(l.image,`/grammar-thumbnails/${l.id}.webp`,`${l.id} uses its own grammar thumbnail`);\n",
        "after": "  assert.equal(l.image,grammarThumbnailPath(l.id,l.level),`${l.id} uses its current grammar thumbnail`);\n"
