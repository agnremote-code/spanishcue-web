  "reason": "Owner requires one CEFR level per grammar class. Exact metadata and source reversals keep every historical conversation bank, route and access assertion authoritative.",
  "sourceEdits": {
    "app/Library.tsx": [
      {
        "before": "        return lesson.category==='Gramática'?{...item,title:lesson.title,copy:`${lesson.duration}. ${lesson.subtitle}`,route:lesson.tag}:item;\n",
        "after": "        return lesson.category==='Gramática'?{...item,kicker:`NUEVA CLASE · GRAMÁTICA ${lesson.level}`,title:lesson.title,copy:`${lesson.duration}. ${lesson.subtitle}`,route:lesson.tag}:item;\n"
      }
    ],
    "app/grammar-classroom/GrammarCourse.tsx": [
      {
        "before": "// The very first class sits with A1, as in the library: no level group with a single class.\nconst courseLevels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];\n",
        "after": "const courseLevels = ['A0', 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'];\n"
      }
    ],
    "app/grammar-classroom/catalog.ts": [
      {
        "before": "",
        "after": "import { courseUnitById } from './curriculum';\n"
      },
      {
        "before": "",
        "after": "  const unit=courseUnitById(lesson.id);\n  if (!unit) throw new Error(`Falta el nivel curricular de ${lesson.id}`);\n"
      },
      {
        "before": "  return {...lesson,...metadata,subtitle,duration:'≈ 60 min',searchAliases:[...(lesson.searchAliases||[]),lesson.title],\n",
        "after": "  // Guided classes have one curriculum level; older reference banks can cover\n  // more levels without promoting the class into those library filters.\n  return {...lesson,...metadata,level:unit.level,levels:[unit.level],displayLevel:unit.level,subtitle,duration:'≈ 60 min',searchAliases:[...(lesson.searchAliases||[]),lesson.title],\n"
      }
    ],
    "app/lesson-catalog.ts": [
      {
        "before": "",
        "after": "import { grammarThumbnailPath } from \"./grammar-classroom/thumbnail-path.mjs\";\n"
      },
      {
        "before": "  return {...lesson,countryCollection:countryLessonIds.has(lesson.id),image:lesson.category===\"Gramática\"?`/grammar-thumbnails/${lesson.id}.webp`:lessonPreviews[lesson.id]||lesson.image||categoryPreviews[lesson.category]};\n",
        "after": "  return {...lesson,countryCollection:countryLessonIds.has(lesson.id),image:lesson.category===\"Gramática\"?grammarThumbnailPath(lesson.id,lesson.level):lessonPreviews[lesson.id]||lesson.image||categoryPreviews[lesson.category]};\n"
      }
    ],
    "app/library-filters.mjs": [
      {
        "before": "    (level === 'Todos' || lesson.level === level || lesson.levels?.includes(level)) &&\n",
        "after": "    (level === 'Todos' || lesson.level === level || (lesson.category !== 'Gramática' && lesson.levels?.includes(level))) &&\n"
      },
      {
        "before": "    .flatMap(l => [l.level, ...(l.levels || [])]));\n",
        "after": "    .flatMap(l => l.category === 'Gramática' ? [l.level] : [l.level, ...(l.levels || [])]));\n"
      }
    ],
