      "text": "What is hard for you?"
    },
    {
      "path": "app/el-mundo-en-blanco/levels/a0.mjs",
      "text": "What mistake do you often make in Spanish?"
    },
    {
      "path": "app/el-mundo-en-blanco/levels/a0.mjs",
      "text": "Who helps you with your mistakes?"
    },
    {
      "path": "app/el-mundo-en-blanco/levels/a0.mjs",
