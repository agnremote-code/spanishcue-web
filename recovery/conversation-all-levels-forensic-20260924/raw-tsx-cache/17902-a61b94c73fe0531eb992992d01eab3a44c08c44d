ring, string, string],\n  follow: [string, string], resources: [string, string, string, string], teacher: string): Episode {\n  return {\n    emoji, title, english: '', context: [context, ''], mission,\n    dialogue: dialogue.map((line, i) => [i % 2 ? 'V' : 'P', line, ''] as DialogueLine),\n    prompts: prompts.map(line => [line, ''] as Pair),\n    follow, resources: resources.map(line => [line, ''] as Pair), teacher,\n  };\n}\n\nexport const argentoTracks: Record<ArgentoLevel, ArgentoTrack> = {\n  A2: {\n    level: 'A2', mission: 'Resolvés cambios de planes en Buenos Aires. Pedí el dato que falta, ofrecé otra opción y confirmá el acuerdo.',\n    start: 'Tenías una tarde organizada. Elegí dos escenas; en cada una algo cambia y necesitás hablar con otra persona para seguir.',\n    stages: [['Entrada: contá tu plan', 5], ['Exploración: leé una escena y ensayá dos frases', 10], ['Interacción: representá dos cambios con nuevos datos', 20], ['Cierre: acordá una tarde posible', 10]],\n    teacher: 'Tomá el otro papel. Después del tercer turno cambiá un dato concreto (hora, lugar o disponibilidad) y pedí confirmación explícita. En grupo, rotá roles.',\n    supports: ['Pensaba ir a…', '¿A qué hora queda bien?', 'Podemos cambiar a…', 'Entonces nos vemos en…'],\n    close: ['¿Qué plan cambió y por qué?', 'Llamá a otra persona y explicale el nuevo horario y lugar.', '¿Qué harías si vuelve a cambiar el transporte?'],\n    episodes: [\n      episode('☕','El café sin mesa','La reserva de un café porteño era para las seis; ahora solo hay mesa a las siete.','Acordá con tu amistad una espera útil y confirmá dónde se encuentran.',\n        ['Che, la mesa para las seis no está.','¿Hay una a las siete? Podemos esperar.','Sí, pero el museo de al lado cierra a las seis y media.','Entonces caminemos primero y volvamos a las siete.'],\n        ['¿Para qué hora era la reserva?','No hay mesa a las seis. ¿Te sirve a las siete?','¿Dónde esperamos mientras tanto?','El museo cierra a las seis y media. ¿Cambiamos el orden?','Tu amistad llega veinte minutos tarde. ¿Qué le decís?','Confirmame lugar y hora del encuentro nuevo.'],\n        ['¿Qué información necesitás del café antes de salir?','¿Cómo avisarías el cambio a alguien que ya va en camino?'],\n        ['¿Te viene bien a las…?','Mientras tanto podemos…','Dale, quedamos en…','Te aviso cuando llegue.'],\n        'Como mozo, ofrecé otra mesa pero no confirmes el horario hasta que el alumno pregunte; luego actuá como la amistad que llega tarde.'),\n      episode('🚇','Subte interrumpido','Vas a encontrarte con una persona en Palermo, pero la línea de subte se detiene.','Pedí una ruta alternativa y acordá un nuevo punto de encuentro.',\n        ['Se frenó la línea D, che.','¿Hay un bondi que vaya cerca?','Sí, pero tarda media hora.','Entonces avisemos y nos vemos en la plaza.'],\n        ['¿En qué estación estás ahora?','¿Cuánto tarda el bondi?','¿Dónde se toma y dónde bajamos?','Tu acompañante prefiere caminar. ¿Qué opción elegís?','El bondi se retrasa diez minutos más. ¿Qué mensaje mandás?','Repetí el nuevo punto de encuentro para comprobarlo.'],\n        ['¿Qué dato faltaba para elegir entre bondi y caminata?','¿Cómo explicarías la ruta a una visita que no conoce la ciudad?'],\n        ['Estoy en la estación…','¿Dónde para el bondi?','Queda a… cuadras.','Nos vemos delante de…'],\n        'Dá direcciones breves como empleado de la estación. Cambiá el tiempo de llegada después de que el alumno proponga su primera ruta.'),\n      episode('🥗','Asado bajo techo','Te invitan a un asado; empieza a llover y una persona no come carne.','Reorganiza comida y lugar para que todos puedan participar.',\n        ['Se largó a llover. El patio no sirve.','Podemos comer adentro. ¿Hay lugar?','Sí, pero falta una opción sin carne.','Paso por la verdulería y llevo algo.'],\n        ['¿Cuántas personas vienen?','¿Hay espacio para comer adentro?','Una invitada no come carne. ¿Qué le ofrecés?','La verdulería cierra pronto. ¿Quién puede pasar?','Falta una silla. ¿A quién le pedís ayuda?','Decí qué lleva cada persona y a qué hora llega.'],\n        ['¿Cómo comprobás una necesidad alimentaria sin hacer suposiciones?','¿Qué cambiás si la lluvia termina antes de comer?'],\n        ['¿Comés…?','Yo llevo…','¿Podés traer…?','Entonces cada uno trae…'],\n        'Hacé de anfitrión: revelá primero la lluvia y después una necesidad alimentaria; aceptá una solución solamente si asigna tareas concretas.'),\n      episode('🏪','Cambio en el kiosco','Compraste una bebida equivocada y el kiosco está por cerrar.','Explicá el error con cortesía, pedí opciones y terminá la compra.',\n        ['Buenas, creo que me llevé otra bebida.','A ver, ¿cuál habías pedido?','Una sin azúcar. Esta es la normal.','Dale, la cambio si queda alguna en la heladera.'],\n        ['¿Qué compraste y qué querías?','¿Tenés el ticket?','Ya no queda la bebida sin azúcar. ¿Qué otra opción pedís?','El precio es distinto. ¿Cómo preguntás cuánto falta?','El kiosquero cierra en cinco minutos. ¿Qué decidís?','Confirmá los productos y la forma de pago.'],\n        ['¿Qué frase evita culpar a la otra persona antes de revisar el pedido?','¿Qué hacés si tampoco queda tu segunda opción?'],\n        ['Creo que hubo un error.','Había pedido…','¿Te queda…?','Pago la diferencia.'],\n        'Como kiosquero, pedí aclaración del producto y ofrecé una alternativa real; esperá que el alumno confirme antes de cerrar.'),\n    ],\n  },\n  B1: {\n    level: 'B1', mission: 'Contás experiencias porteñas, explicás por qué tomaste una decisión y recomendás qué hacer la próxima vez.',\n    start: 'Una foto o un objeto abre un recuerdo. Elegí dos escenas y reconstruí lo que pasó, la decisión más importante y cómo terminó.',\n    stages: [['Entrada: evocá una experiencia', 5], ['Exploración: ordená hechos y motivos', 10], ['Interacción: dos relatos y preguntas del interlocutor', 20], ['Cierre: recomendación personal', 10]],\n    teacher: 'Escuchá como una amistad que no conoce la historia. Pedí una causa, un cambio de decisión y una consecuencia; después contá una experiencia distinta para comparar. En grupos, cada persona puede traer un recuerdo inventado.',\n    supports: ['Al principio…', 'Como se había…', 'Entonces decidimos…', 'La próxima vez yo…'],\n    close: ['¿Qué momento te hizo cambiar de plan?', 'Contá la misma experiencia desde el punto de vista de otra persona.', '¿Qué consejo concreto le darías a alguien en esa situación?'],\n    episodes: [\n      episode('🧉','El primer mate','Una foto de una ronda de mate te recuerda el día en que conociste a un grupo nuevo.','Relatá el encuentro y explicá cómo cambió tu primera impresión.',\n        ['¿Te acordás de aquella ronda en la plaza?','Sí, pensé que no conocía a nadie.','¿Y cuándo empezaste a hablar?','Cuando me preguntaron por mi barrio y me hicieron lugar.'],\n        ['¿Dónde y con quién empezó la ronda?','¿Qué pensabas antes de llegar?','¿Qué gesto te hizo sentir parte del grupo?','¿Hubo algo que interpretaste mal al principio?','¿Qué hiciste después del encuentro?','¿Qué recomendarías a una persona nueva en ese grupo?'],\n        ['¿Qué detalle del lugar ayuda a entender tu reacción?','¿Contaría la anfitriona el mismo encuentro de otra manera?'],\n        ['Me acuerdo de que…','Al principio creí que…','Después entendí que…','Desde ese día…'],\n        'Como anfitrión, preguntá por un detalle concreto y contá que creías que la persona no quería hablar; comparen ambas impresiones.'),\n      episode('🎟️','Un recital casi perdido','Un billete arrugado te devuelve a una noche con tráfico, lluvia y una entrada que parecía inútil.','Narrá el problema, la decisión tomada y el final de la salida.',\n        ['Llegamos cuando ya había empezado.','¿Fueron igual o volvieron?','Entramos y escuchamos la segunda mitad.','Al final fue la parte que más recordamos.'],\n        ['¿Quién propuso ir al recital?','¿Qué salió mal en el trayecto?','¿Qué alternativas tuvieron al llegar tarde?','¿Por qué decidieron entrar igual?','¿Cómo reaccionó la otra persona?','¿Qué cambiarías si volvieras a organizar esa noche?'],\n        ['¿Qué habría pasado si se quedaban en casa?','¿Qué parte del relato necesitaría más detalles para sonar verosímil?'],\n        ['La idea era…','Pero en el camino…','Por eso decidimos…','Aunque llegamos tarde…'],\n        'Como acompañante, recordá un desacuerdo sobre entrar o volver; pedí que el alumno explique tu punto de vista antes del suyo.'),\n      episode('💼','El primer día de laburo','Una credencial trae a la memoria tu primer día en un trabajo o un proyecto nuevo.','Contá una dificultad, cómo pediste ayuda y qué aprendiste.',\n        ['Ese primer día nadie sabía mi nombre.','¿Preguntaste a quién acudir?','Sí, pero me equivoqué de oficina.','Por suerte una compañera me mostró todo.'],\n        ['¿Qué esperabas antes de empezar?','¿Qué instrucción no estaba clara?','¿A quién le pediste ayuda y cómo?','¿Qué error o sorpresa cambió la jornada?','¿Cómo lo vivió la persona que te ayudó?','¿Qué le dirías a quien empieza mañana?'],\n        ['¿La dificultad era de información o de confianza?','¿Qué señal concreta te mostró que ya entendías el lugar?'],\n        ['Esperaba que…','No sabía dónde…','Le pedí a…','Aprendí que…'],\n        'Hacé de compañera de trabajo. Ofrecé ayuda parcial y preguntá qué necesita saber el alumno para seguir con autonomía.'),\n      episode('📅','La juntada que cambió','Una invitación vieja recuerda una reunión de amistades que se reorganizó a último momento.','Relatá cómo negociaste el cambio y qué ocurrió realmente.',\n        ['Pensábamos ir a la terraza.','¿Por qué terminaron en tu casa?','El viento era fuerte y dos personas llegaban tarde.','Improvisamos una cena y salió mejor de lo previsto.'],\n        ['¿Cuál era el plan original?','¿Quién avisó primero que no llegaba?','¿Por qué el lugar dejó de servir?','¿Quién propuso el plan nuevo y con qué motivo?','¿Alguien quedó afuera de la decisión?','¿Qué recordarías de esa noche dentro de un año?'],\n        ['¿Hubo una consecuencia inesperada del cambio?','¿Qué versión de la historia contaría la persona que llegó tarde?'],\n        ['Habíamos quedado en…','Como no podíamos…','Al final…','Lo curioso fue que…'],\n        'Como invitado que llegó tarde, recordá una versión diferente del motivo del cambio y pedí al alumno que una los relatos.'),\n    ],\n  },\n  B2: {\n    level: 'B2', mission: 'Defendés alternativas en situaciones porteñas con restricciones reales y llegás a acuerdos que puedan revisarse.',\n    start: 'Dos personas quieren algo legítimo, pero el espacio, el tiempo o el presupuesto no alcanzan. Elegí dos escenas y negociá sin perder de vista a la otra parte.',\n    stages: [['Entrada: tomá posición', 5], ['Exploración: compará dos alternativas', 10], ['Interacción: objeciones y concesiones en dos escenas', 20], ['Cierre: acuerdo con condiciones', 10]],\n    teacher: 'Representá el interés contrario con una razón válida. Una vez acordado el principio, introducí un costo nuevo o una tercera voz y pedí una revisión concreta. En grupo, un observador identifica concesiones.',\n    supports: ['Entiendo tu prioridad, aunque…', 'La alternativa tendría esta ventaja…', 'Podría ceder en… si…', 'Revisemos el acuerdo cuando…'],\n    close: ['¿Qué concesión hiciste y qué recibiste a cambio?', '¿Quién debería revisar el acuerdo y cuándo?', '¿Qué objeción del otro lado quedó sin resolver?'],\n    episodes: [\n      episode('🍻','Un bar para todos','Tu grupo eligió un bar ruidoso con escalones; una amistad necesita acceso sin barreras.','Negociá lugar y horario con quien ya reservó, sin excluir a nadie.',\n        ['Ya dejé una seña para el bar de siempre.','Una persona no puede entrar por esos escalones.','Si cancelamos hoy, perdemos parte de la seña.','Podemos llamar y pedir otra sede o fecha.'],\n        ['¿Qué necesita exactamente la persona que no puede acceder?','¿Qué seña perdería el grupo si cambia el lugar?','Defendé una alternativa con acceso y ambiente adecuado.','La persona que reservó objeta que es más caro. ¿Qué respondés?','El otro bar cierra temprano. ¿Qué condición cambiás?','Cerrá un acuerdo con persona responsable y hora de confirmación.'],\n        ['¿Cómo evitarías que la persona afectada tenga que justificar su necesidad?','¿Quién debería asumir el costo extra y por qué?'],\n        ['El acceso es una condición.','Compensemos la seña con…','Si cerramos a las…','Voy a confirmarlo antes de…'],\n        'Como organizador, defendé la reserva hecha y su costo. Concedé solo después de oír una solución de acceso y presupuesto.'),\n      episode('🏠','El departamento compartido','Dos convivientes discrepan sobre visitas, limpieza y gastos de una cocina pequeña.','Defendé una regla viable y respondé a la objeción de quien comparte el espacio.',\n        ['No me molesta que vengan tus amistades.','Pero me avisás cuando ya están acá.','Yo tampoco quiero pedir permiso por cada visita.','Entonces acordemos un aviso y un horario razonable.'],\n        ['¿Qué problema produce cada postura sobre las visitas?','Proponé un aviso que no parezca pedir permiso.','La otra persona trabaja temprano. ¿Qué límite aceptás?','Los gastos de comida común suben. ¿Cómo los repartís?','Llega una visita por una emergencia. ¿Qué excepción aplicarías?','Resumí la regla y una fecha para revisarla.'],\n        ['¿Qué parte es convivencia y qué parte es preferencia personal?','¿Cómo sabrán si la regla funciona después de dos semanas?'],\n        ['Mi límite sería…','Podría aceptar… siempre que…','Para una excepción…','Revisamos esto el…'],\n        'Como conviviente, defendé tiempo privado y presupuesto; luego traé una excepción genuina que ponga a prueba la regla.'),\n      episode('⚽','Partido y vecinos','Querés organizar un partido en pantalla grande, pero la terraza tiene vecinos y un presupuesto limitado.','Acordá un evento que respete descanso, seguridad y ganas de reunirse.',\n        ['La terraza tiene lugar para veinte.','Los vecinos pidieron terminar antes de las once.','El partido puede ir a tiempo extra.','Podemos bajar adentro después de cierta hora.'],\n        ['¿Quiénes necesitan usar la terraza además del grupo?','Compará proyector arriba y pantalla dentro.','Un vecino objeta el ruido. ¿Qué garantía ofrecés?','El alquiler del proyector sube el costo. ¿Qué recortás?','El partido se alarga. ¿Cuál es el plan acordado?','Explicá las condiciones a invitadas y vecinos.'],\n        ['¿Qué costo no aparece en el presupuesto?','¿La solución funciona igual si llueve?'],\n        ['La ventaja de… es…','No podemos prometer silencio, pero…','Si se alarga…','Nos comprometemos a…'],\n        'Representá a un vecino que disfruta del partido pero necesita dormir; exigí condiciones verificables, no solo buenas intenciones.'),\n      episode('🛒','El mercado del barrio','La feria cambia de calle por obras; comerciantes y residentes discrepan sobre circulación y ventas.','Defendé una ubicación provisional con horario, acceso y criterio de revisión.',\n        ['Si nos movemos dos cuadras, perdemos clientes.','Acá la ambulancia no puede pasar.','La plaza tiene lugar, pero solo los sábados.','Probemos un mes y midamos qué pasa.'],\n        ['¿Qué necesita cada comerciante para no perder ventas?','¿Qué acceso debe quedar libre para residentes?','Compará plaza y avenida con dos criterios.','Una vendedora objeta el horario del sábado. ¿Qué alternativa ofrecés?','La primera semana vende menos de lo previsto. ¿Qué revisás?','Formulá un pacto de prueba con datos y responsables.'],\n        ['¿Qué grupo faltó en la primera negociación?','¿Cuándo sería justo abandonar la prueba?'],\n        ['Para que funcione, necesitamos…','Reconozco esa pérdida; propongo…','Hagamos una prueba de…','Si los datos muestran…'],\n        'Como feriante, insistí en que una ubicación accesible no garantiza ventas; pedí una medida de apoyo y plazo.'),\n    ],\n  },\n  C1: {\n    level: 'C1', mission: 'Interpretás tonos e intenciones sin dar por hecho el subtexto; reformulás mensajes y mediás según la relación.',\n    start: 'Una expresión porteña suena distinta según quién la dice y quién la recibe. Elegí dos escenas y practicá una reparación que cuide el sentido y a las personas.',\n    stages: [['Entrada: primera lectura', 5], ['Exploración: contexto y registro', 10], ['Interacción: mediación y reformulación en dos escenas', 20], ['Cierre: síntesis para dos destinatarios', 10]],\n    teacher: 'Mostrá una interpretación alternativa plausible antes de confirmar la intención. Cambiá la relación entre interlocutores en el segundo turno y pedí reformular. En grupo, una tercera persona vigila que cada voz quede representada.',\n    supports: ['Quizá interpreté mal, pero…', 'Si te entiendo bien, querés decir…', 'En este contexto sonaría más…', 'Dejemos explícito lo que acordamos.'],\n    close: ['¿Qué dato de contexto cambió tu lectura?', 'Explicá el desacuerdo a una amistad y luego a una persona desconocida.', '¿Qué frase elegirías para reparar sin atribuir una mala intención?'],\n    episodes: [\n      episode('💬','Che, en el laburo','Una compañera manda «che, eso no da» en un grupo de trabajo después de un cambio de horario.','Averiguá a qué se refiere y reformulá el reclamo para la coordinadora.',\n        ['Che, eso no da.','¿Hablás del horario o de cómo lo anunciamos?','De las dos cosas; nadie consultó al equipo.','Déjame separar el problema y proponerte cómo plantearlo.'],\n        ['¿Qué sentidos puede tener «no da» acá?','¿Qué dato falta para entender el reclamo?','Preguntá sin exigir que retire el mensaje.','Una jefa lee el chat y cree que es una falta de respeto. ¿Qué le dirías?','Reformulá el reclamo en registro de reunión formal.','Volvé al chat y confirmá con la compañera si la representaste bien.'],\n        ['¿Cambiaría tu lectura si son amigas desde hace años?','¿Qué parte del tono perderías al escribir un acta?'],\n        ['Puede que te haya entendido mal.','El punto de fondo sería…','Lo plantearía así en la reunión…','¿Es fiel a lo que querías decir?'],\n        'Como compañera, aclarás que «no da» expresa frustración pero no un ataque personal; como jefa, pedís un resumen que no borre el malestar.'),\n      episode('🏡','Caé cuando quieras','Una amistad dice «caé cuando quieras»; otra persona llega sin avisar durante una cena familiar.','Mediá entre hospitalidad y límites personales sin decidir por nadie qué quiso decir.',\n        ['Che, me dijiste que podía caer cuando quisiera.','Sí, pero esta noche estoy con mi familia.','Entendí que la invitación era abierta.','Fue cariñosa, pero necesito que arreglemos antes.'],\n        ['¿La expresión era invitación literal o fórmula de afecto?','Preguntá qué necesitaba cada persona esa noche.','Quien llegó se siente rechazado. ¿Cómo recogés esa vivencia?','La anfitriona se siente invadida. ¿Cómo la representás?','Proponé una frase futura más clara para ambas.','Buscá un gesto de reparación que no implique quedarse a la cena.'],\n        ['¿Qué dirías si se tratara de una familia muy cercana?','¿Cómo suena «avisame antes» según el tono?'],\n        ['Cuando dijiste…, entendí…','Veo que para vos…','Quizá podemos decir…','Esta noche no hace falta…'],\n        'Representá primero a quien llegó y luego a quien recibe. No aceptes una reparación que obligue a alguien a abrir su casa.'),\n      episode('📱','El audio del edificio','Un audio vecinal sobre basura fue reenviado fuera del grupo y sonó como un ataque personal.','Aclarar el alcance del reclamo y frenar una escalada sin pedir silencio.',\n        ['En mi audio dije que el pasillo estaba sucio.','Pero se entiende que me acusás a mí.','No nombré a nadie; igual veo que sonó así.','Podemos aclarar el problema sin señalar a una persona.'],\n        ['¿Qué parte del audio informa y cuál permite inferencias?','Preguntá quién reenvió el mensaje y para qué.','Reformulá la queja para el grupo sin exponer a nadie.','La persona afectada quiere una disculpa pública. ¿Qué proponés?','Una vecina teme que no se resuelva la basura. ¿Cómo la incluís?','Cerrá con próximo paso y canal de seguimiento.'],\n        ['¿Qué cambiaría si el audio contenía un nombre?','¿Cuándo aclarar públicamente ayuda y cuándo amplifica el daño?'],\n        ['Mi intención era señalar…','Entiendo que se pudo interpretar…','El problema concreto es…','Propongo revisarlo el…'],\n        'Como vecina afectada, exigí que se reconozca el impacto. Luego como otra vecina pedí que el problema material no quede sin resolver.'),\n      episode('🥩','Un chiste en el asado','En una mesa, un comentario irónico sobre el trabajo de alguien provoca risas y silencio a la vez.','Intervení con tacto, comprobá cómo se recibió y repará sin hacer espectáculo.',\n        ['Era un chiste, che.','Para vos sí, pero quedé expuesto frente a todos.','No me di cuenta de que te molestaba.','Hablemos un momento aparte y después vemos qué decir.'],\n        ['¿Qué señales indican que el comentario no cayó igual para todos?','Acercate a la persona afectada sin hablar por ella.','La autora insiste en que no hubo mala intención. ¿Cómo respondés?','Proponé una reparación breve en privado.','La mesa pregunta qué ocurrió. ¿Qué no contarías?','Reformulá la misma intervención para alguien con poca confianza.'],\n        ['¿Cuándo una explicación agrava una disculpa?','¿Quién decide si el asunto debe volver a la mesa?'],\n        ['No sé cómo lo recibiste.','Entiendo la intención, pero…','Si te parece, lo hablamos aparte.','No necesito contar detalles.'],\n        'Como persona afectada, no reveles aún qué gesto ayudaría; pedí que escuchen antes de proponer una solución pública.'),\n    ],\n  },\n  C2: {\n    level: 'C2', mission: 'Reconstruís versiones parciales y reformulás expresiones ambiguas con precisión sin borrar lo que sigue en disputa.',\n    start: 'Varias personas recuerdan la misma noche de modo distinto. Elegí dos escenas, separá hechos e interpretaciones y construí un relato útil para conversar.',\n    stages: [['Entrada: dos versiones', 5], ['Exploración: voces y omisiones', 10], ['Interacción: síntesis revisable en dos escenas', 20], ['Cierre: reformulación precisa', 10]],\n    teacher: 'Ofrecé un testimonio verosímil que contradiga una inferencia inicial y pedí que el alumno rectifique sin descartar la primera voz. No busques un veredicto; pedí una formulación que diga qué se sabe, qué no y qué permitiría avanzar.',\n    supports: ['Con los datos disponibles…', 'Esa palabra podría implicar…, aunque…', 'Ambas versiones coinciden en…', 'Queda pendiente precisar…'],\n    close: ['¿Qué interpretación cambió al escuchar a otra persona?', 'Contá lo ocurrido con una frase que distinga certeza e inferencia.', '¿Qué reparación podría funcionar aun sin una versión única?'],\n    episodes: [\n      episode('📦','El paquete de la juntada','Un paquete con comida desaparece antes de una reunión; tres personas recuerdan entregas diferentes.','Uní las versiones sin convertir el recuerdo incompleto en culpa.',\n        ['Yo lo dejé al lado de la puerta.','Vi una bolsa, pero alguien la movió.','Creí que era para otra casa.','Antes de culpar, reconstruyamos la secuencia.'],\n        ['¿Qué afirma cada persona haber visto?','¿En qué minuto coinciden sus recuerdos?','¿Quién infiere que alguien se lo llevó y por qué?','Aparece una foto que muestra otra bolsa. ¿Qué corregís?','Proponé una frase para el grupo sin señalar culpables.','¿Qué dato pedirías para evitar otro malentendido?'],\n        ['¿Qué diferencia hay entre «desapareció» y «lo robaron»?','¿Cómo preservás la confianza sin fingir certeza?'],\n        ['Según lo que cada uno recuerda…','Eso sugiere…, pero no demuestra…','Me corrijo en este punto…','Podemos comprobar…'],\n        'Como tercer testigo, introducí una foto parcial y pedí que el alumno distinga objetos parecidos antes de concluir.'),\n      episode('🚕','El viaje compartido','Tres pasajeros discuten quién aceptó un cambio de ruta y quién debe pagar el costo extra.','Reconstruí acuerdo, silencio y malentendidos antes de proponer un reparto.',\n        ['Pregunté si íbamos por otra calle.','Yo escuché una sugerencia, no una decisión.','El conductor entendió que los tres aceptaban.','Entonces acordemos qué se dijo y qué quedó tácito.'],\n        ['¿Cuál fue la frase exacta que recuerda cada cual?','¿Quién tenía capacidad de confirmar la ruta?','¿El silencio bastaba como consentimiento en esa situación?','El recibo muestra un desvío previo. ¿Qué cambia?','Proponé un reparto que no atribuya certezas falsas.','¿Qué frase usarían la próxima vez para confirmar?'],\n        ['¿Cómo distinguirías responsabilidad compartida de culpa igual para todos?','¿Qué término del relato resulta demasiado concluyente?'],\n        ['Recuerdo que se dijo…','Eso no equivale necesariamente a…','Rectifico: el desvío empezó…','Una distribución provisional sería…'],\n        'Como conductor, recordá una confirmación que los demás no registraron; luego mostrales un recibo cuyo horario altera la secuencia.'),\n      episode('📷','Una foto de la reunión','Una fotografía de una cena circula con el comentario «se arregló todo», pero dos protagonistas discrepan.','Explicá qué permite ver la imagen y qué no permite concluir.',\n        ['En la foto todos estamos sonriendo.','Eso no significa que hayamos resuelto el problema.','Yo pensé que ya habíamos hecho las paces.','Tal vez acordamos una pausa, no un cierre.'],\n        ['¿Qué muestra la foto sin necesidad de interpretar?','¿Qué quiso comunicar quien escribió el pie?','¿Qué asunto seguía abierto según la otra persona?','Aparece un mensaje posterior cortés pero distante. ¿Cómo lo leés?','Redactá una aclaración que no exponga detalles íntimos.','¿Qué conversación falta para verificar el supuesto acuerdo?'],\n        ['¿Cuándo «hacer las paces» oculta un desacuerdo legítimo?','¿Podría una de las partes preferir no aclarar públicamente?'],\n        ['La imagen registra…','De ahí no se desprende que…','Podríamos decir, con más precisión…','Respetemos el derecho a…'],\n        'Como protagonista de la foto, aceptá que hubo cordialidad, pero negá que haya un acuerdo definitivo; pedí discreción pública.'),\n      episode('🗣️','El sentido de «ya fue»','Una amistad dice «ya fue» al cancelar un plan; otra lo oye como indiferencia y una tercera como alivio.','Interpretá los matices según entonación, relación y hechos posteriores.',\n        ['Dije «ya fue» porque no quería presionarte.','A mí me sonó a que no te importaba.','Yo pensé que habíamos encontrado otra opción.','Entonces hablemos de lo que cada uno necesitaba.'],\n        ['¿Qué tres sentidos plausibles tiene «ya fue» aquí?','¿Qué datos de la relación faltan para elegir uno?','¿Cómo preguntás por intención sin invalidar el impacto?','Un audio revela un suspiro antes de la frase. ¿Qué cambia?','Reformulá el mensaje para cuidar al otro sin prometer un plan falso.','Cerrá con lo acordado y con la diferencia que sigue abierta.'],\n        ['¿Cuál sería una traducción engañosa de la expresión?','¿Qué palabra conservarías si hablaras con un amigo de otra región?'],\n        ['En ese tono podría sugerir…','Sin embargo, para vos sonó…','Quise decir que…','Aunque no coincidimos en…'],\n        'Como amistad, admití una intención amable y mantené el impacto negativo; exigí una reformulación que no sea una explicación defensiva.'),\n    ],\n  },\n};\n"]}}