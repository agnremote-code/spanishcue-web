 type AgencyActivities={\n  dossiers:Dossier[];\n  stages:readonly (readonly [string,string])[];\n  interviewQuestions:readonly string[];\n  values:readonly string[];\n  finalQuestions:readonly FinalQuestion[];\n  languageSupport:Record<string,readonly string[]>;\n  copy:AgencyCopy;\n  hook:string;cover:string;alt:string;\n};\n\ntype CaseRow=readonly [\n  id:string,door:string,signal:string,decision:string,probe:string,\n  consequence:string,consequencePrompt:string,cost:string,reconsider:string,\n  person:string,role:string,line:string,teacher:string,\n  rewrite:string,rippleOne:string,rippleTwo:string,finalPrompt:string,\n];\nfunction files(level:Exclude<AgencyLevel,\"C1\">,rows:readonly CaseRow[]):Dossier[]{\n  if(rows.length!==6)throw new Error(`${level}: six doors need complete stories`);\n  return rows.map(([id,door,signal,decision,probe,consequence,consequencePrompt,cost,reconsider,name,role,line,teacher,rewrite,rippleOne,rippleTwo,finalPrompt],index)=>({\n    id,code:`VP-${level}-${String(index+1).padStart(2,\"0\")}`,door,signal,decision,probe,\n    consequence,consequencePrompt,cost,reconsider,\n    person:{name,role,line,teacher},rewrite,ripples:[rippleOne,rippleTwo],finalPrompt,\n  }));\n}\nfunction finals(rows:readonly (readonly [string,string,string])[]):FinalQuestion[]{\n  if(rows.length<6)throw new Error(\"At least six final conversation paths are required\");\n  return rows.map(([q,f,c])=>({q,f,c}));\n}\nfunction activities(level:Exclude<AgencyLevel,\"C1\">,data:Omit<AgencyActivities,\"stages\"|\"cover\">):AgencyActivities{\n  return {...data,stages,cover:`/conversation-variants/agencia-vidas-paralelas-${level.toLowerCase()}.webp`};\n}\n\nconst c1Copy:AgencyCopy={\n  kicker:\"C1 · HIPÓTESIS, CONSECUENCIAS Y DECISIONES\",\n  opening:\"Seis puertas conservan vidas que pudieron ocurrir. Elige una sin conocer la decisión, anticipa lo que hay detrás y habla antes de desbloquear cada capa.\",\n  warmup:\"¿Una vida alternativa revela lo que deseamos o solo lo que hoy echamos de menos?\",\n  sealedTitle:\"¿Qué clase de vida crees que esconde este acceso?\",\n  sealedTask:\"Formula dos hipótesis distintas. Explica qué indicio te hace confiar más en una y qué dato podría cambiarla.\",\n  fileTeacher:\"No reveles la siguiente capa hasta que el alumno formule una hipótesis, una razón y una reserva. Cuestiona una certeza excesiva con: «¿Qué estás suponiendo para llegar a esa conclusión?»\",\n  verdict:\"Resume tu posición inicial. Después cambia, limita o refuerza una parte concreta a la luz del costo oculto.\",\n  interviewTitle:\"La versión que siguió ese camino\",\n  interviewTask:\"Escucha la respuesta del profesor, cuestiona una premisa y formula una repregunta que no pueda responderse con sí o no.\",\n  balanceTitle:\"Toda vida optimiza algo.\",\n  balanceTask:\"Elige solo tres valores que esta vida debería proteger. Después identifica la contradicción entre dos de ellos y explica cuál cedería primero bajo presión.\",\n  balanceSentence:selected=>`Quiero conservar ${selected[0].toLowerCase()} y ${selected[1].toLowerCase()}, aunque eso podría reducir ${selected[2].toLowerCase()}.`,\n  balanceFollowup:\"Reformula la frase desde la perspectiva de alguien que ordenaría esos valores de otra manera.\",\n  rewriteTitle:\"Puedes cambiar una decisión.\",\n  rewriteTask:\"Elige el expediente que quieres reescribir. Primero defiende el cambio; después abre la propagación y negocia los dos efectos que no puedes evitar.\",\n  rewriteQuestions:\"¿Qué problema resuelve? ¿Qué valor protege? ¿Qué riesgo estás dispuesto a aceptar?\",\n  rippleTask:\"El profesor exige que mantengas uno de los dos efectos y agrava el otro. Negocia una versión que todavía puedas defender.\",\n  finalTitle:\"La vida que no viene con expediente\",\n  finalTask:\"Una pregunta por vez. Desarróllala con una historia, una distinción o un ejemplo; después abre la repregunta y el contraargumento.\",\n  finalReveal:\"ABRIR REPREGUNTA + CONTRAARGUMENTO\",finalChallengeLabel:\"EL PROFESOR CUESTIONA\",\n  closingTitle:\"Una decisión ficticia que ahora juzgas de otra manera\",\n  closingTask:\"Explica tu primera lectura, el dato que la modificó y la posición que defenderías ahora sin borrar la contradicción.\",\n  paceShort:\"Ofrece dos opciones concretas, pide un ejemplo y modela una primera frase sin completar la idea por el alumno.\",\n  paceLong:\"Interrumpe con un costo nuevo, exige una síntesis de 45 segundos y pide que defienda la perspectiva contraria.\",\n};\n\nconst c1:ConversationLevelVariant<AgencyActivities>={\n  level:\"C1\",communicativeObjectives:[\"Examinar vidas alternativas con hipótesis complejas, reservas y una revisión informada de la postura\"],\n  expectedFunctions:[\"Especular\",\"Matizar\",\"Reconsiderar y mediar consecuencias\"],\n  pcicFocus:[\"Hipótesis y valoración\",\"Mediación de perspectivas\",\"Relatos personales\"],\n  activities:{dossiers:originalDossiers,stages,interviewQuestions:originalInterviews,values:originalValues,finalQuestions:[...originalFinals],languageSupport:originalSupport,copy:c1Copy,\n    hook:\"Seis puertas abren vidas alternativas: anticipá, entrevistá y reconsiderá una decisión ante sus costos ocultos.\",\n    cover:\"/conversation-premium/agencia-vidas-paralelas.webp\",\n    alt:\"Vestíbulo cinematográfico oscuro con seis portales hacia vidas distintas y una persona que se acerca a elegir.\"},\n  teacherNotes:[\"La C1 original mantiene los seis expedientes y sus tres capas, entrevista, balance, reescritura y conversación final de 45 minutos.\",\"Pedir hipótesis con reserva antes de revelar cada capa; admitir protagonistas ficticios.\"],\n  closingConversation:[\"¿Qué dato cambió tu postura?\",\"¿Qué costo no quisiste borrar?\",\"¿Qué decisión defenderías ahora?\"],\n};\n\nconst a1:ConversationLevelVariant<AgencyActivities>={\n  level:\"A1\",communicativeObjectives:[\"Elegir entre planes cotidianos y comunicar qué hacer, dónde, cuándo y con quién\"],\n  expectedFunctions:[\"Expresar gustos\",\"Pedir datos simples\",\"Invitar y elegir otra opción\"],\n  pcicFocus:[\"Vida cotidiana\",\"Ocio y relaciones\",\"Planes inmediatos\"],\n  activities:activities(\"A1\",{\n    dossiers:files(\"A1\",[\n      [\"cafe\",\"EL CAFÉ DE LA ESQUINA\",\"Huele a pan recién hecho.\",\"Hoy elegís desayunar en una cafetería con Ana.\",\"Decí qué pedís y preguntá qué quiere Ana.\",\"Hay café y dos medialunas; Ana llega a las nueve.\",\"Pedí el desayuno y confirmá la hora.\",\"La cafetería no tiene leche.\",\"Pedí otra bebida o cambiá el pedido.\",\"Ana Ruiz\",\"Amiga de la cafetería\",\"Me gusta tomar té con vos.\",\"Hablá como Ana. Preguntá qué quiere el visitante y decí que el café no tiene leche.\",\"Desayunás en casa y después ves a Ana.\",\"Gastás menos dinero, pero tenés que preparar algo.\",\"Ana solo puede quedarse veinte minutos.\",\"¿Qué desayuno elegís y a qué hora ves a Ana?\"],\n      [\"parque\",\"EL SENDERO DEL PARQUE\",\"Un banco está libre bajo un árbol.\",\"Elegís pasear por el parque con Luis esta tarde.\",\"Decí a qué hora vas y qué llevás.\",\"El parque está abierto y Luis puede ir a las cinco.\",\"Invitá a Luis y confirmá el lugar.\",\"A las cinco empieza a llover.\",\"Proponé un lugar cubierto cerca del parque.\",\"Luis Gómez\",\"Amigo del barrio\",\"Puedo ir después de trabajar.\",\"Preguntá la hora y el lugar. Cuando el visitante confirme, avisá que llueve.\",\"Cambiás el paseo por una visita a la biblioteca.\",\"Podés hablar sin mojarte, pero la biblioteca cierra pronto.\",\"Luis quiere caminar otro día.\",\"¿Qué hacéis hoy y cuándo paseáis?\"],\n      [\"libros\",\"LA PUERTA DE LOS LIBROS\",\"Una luz se enciende entre estantes.\",\"Entrás en la biblioteca para buscar un libro fácil.\",\"Decí qué tema te gusta y pedí ayuda.\",\"La bibliotecaria encuentra un libro con imágenes.\",\"Preguntá cuánto tiempo podés tenerlo.\",\"El libro que querías está prestado.\",\"Elegí otro tema o reservá el libro.\",\"Elena Paz\",\"Bibliotecaria\",\"Tengo este libro y otro parecido.\",\"Mostrá dos libros; preguntá qué tema prefiere y explicá cuándo se devuelve.\",\"Buscás el libro en otra biblioteca.\",\"Tenés que tomar el autobús.\",\"La otra biblioteca abre mañana.\",\"¿Qué libro elegís y cuándo volvés?\"],\n      [\"tren\",\"EL TREN DE LAS DIEZ\",\"Una maleta espera junto a la vía.\",\"Elegís visitar a un amigo en otra ciudad el sábado.\",\"Decí adónde vas y preguntá por el tren.\",\"El tren sale a las diez y llega al mediodía.\",\"Avisá al amigo cuándo llegás.\",\"Solo quedan billetes para las once.\",\"Elegí la nueva hora y comunicásela al amigo.\",\"Nico Torres\",\"Amigo de la estación\",\"Te espero al salir del tren.\",\"Preguntá la hora de llegada y explicá que podés esperar un poco.\",\"Viajás el domingo por la mañana.\",\"El billete cuesta menos.\",\"Tu amigo trabaja el domingo por la tarde.\",\"¿Cuándo viajás y cuánto tiempo tenés para verlo?\"],\n      [\"mercado\",\"LOS PUESTOS DEL MERCADO\",\"Hay frutas de tres colores.\",\"Elegís comprar fruta para una comida con dos amigos.\",\"Nombrá dos frutas y preguntá el precio.\",\"Comprás manzanas y uvas por seis euros.\",\"Decí qué querés preparar y para cuántas personas.\",\"Hoy no hay uvas.\",\"Pedí otra fruta para la misma comida.\",\"Marta Vega\",\"Vendedora\",\"Las manzanas están frescas hoy.\",\"Preguntá qué fruta y cuánta cantidad quiere el visitante; ofrecé una alternativa.\",\"Vas al supermercado después del mercado.\",\"Hay más productos, pero está más lejos.\",\"Tus amigos llegan temprano a comer.\",\"¿Dónde comprás y a qué hora coméis?\"],\n      [\"gimnasio\",\"LA SALA DE MOVIMIENTO\",\"Una clase pequeña está por empezar.\",\"Elegís probar una clase de movimiento el lunes.\",\"Preguntá la hora y decí si querés ir.\",\"La clase empieza a las seis y hay sitio.\",\"Decí con quién querés ir y confirmá el día.\",\"La clase del lunes está completa.\",\"Preguntá por otro día u otra actividad.\",\"Sara León\",\"Recepcionista\",\"También hay una clase e