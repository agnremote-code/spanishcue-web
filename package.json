{
  "name": "biblioteca-espanol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/release-policy.test.mjs tests/production-smoke.test.mjs tests/billing-entitlement.test.mjs tests/staging-worker-config.test.mjs && npm run test:tracker && npm run test:red-flag && npm run test:guides && npm run build && node scripts/test-worker.mjs",
    "test:tracker": "node --test tests/student-tracker.test.mjs tests/student-tracker-http-d1.test.mjs tests/student-tracker-routes.test.mjs tests/student-tracker-ui.test.mjs",
    "test:red-flag": "node --test tests/red-flag-o-no.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "smoke:production": "node scripts/production-smoke.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:guides": "node --test tests/teaching-guides-seo.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "14.4.0",
    "google-auth-library": "10.9.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Biblioteca de Español"
}
